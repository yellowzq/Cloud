# =========================================
# Docker 服务配置模板
# 复制为 .env 并填写真实值，然后 chmod 600 .env
# =========================================

# 根域名（必改）
ROOT_DOMAIN=example.com
MAIN_EMAIL=admin@example.com

# 二级域名（可选，默认基于 ROOT_DOMAIN 生成）
S3_DOMAIN=s3.${ROOT_DOMAIN}
STORAGE_DOMAIN=storage.${ROOT_DOMAIN}
WEBDAV_DOMAIN=webdav.${ROOT_DOMAIN}
FRPS_DOMAIN=frps.${ROOT_DOMAIN}

# RustFS 存储配置（同时作为 WebDAV 凭据）
RUSTFS_ACCESS_KEY=change-me-access-key
RUSTFS_SECRET_KEY=change-me-secret-key
RUSTFS_MAX_REQUEST_SIZE=5368709120

# RustFS 内置 WebDAV（Nginx 终止 TLS）
RUSTFS_WEBDAV_ENABLE=true
RUSTFS_WEBDAV_ADDRESS=0.0.0.0:8080
RUSTFS_WEBDAV_TLS_ENABLED=false

# Compose 项目名（决定命名卷前缀，初始化后勿改）
COMPOSE_PROJECT_NAME=storage-net

# =========================================
# 2 核 2G 资源限制
# limits 合计约 896M；实际常驻约 300M
# 建议额外配置 2G swap 作为兜底
# =========================================

NGINX_MEM_LIMIT=128M
NGINX_MEM_RESERVE=96M

RUSTFS_MEM_LIMIT=640M
RUSTFS_MEM_RESERVE=320M

CERTBOT_MEM_LIMIT=128M
CERTBOT_MEM_RESERVE=32M

# =========================================
# 日志配置
# =========================================
DOCKER_LOG_DRIVER=json-file
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# 健康检查
HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=10s
HEALTHCHECK_RETRIES=3
HEALTHCHECK_START_PERIOD=30s

# =========================================
# 网络配置
# =========================================
NETWORK_NAME=storage-net
NETWORK_DRIVER=bridge

# =========================================
# 存储配置
# =========================================
# 静态站点目录（宿主机路径）
WEB_DATA_DIR=/data/web

# =========================================
# 测试模式（HTTP）
# =========================================
# SKIP_CERTBOT=true bash run.sh init
SKIP_CERTBOT=false
